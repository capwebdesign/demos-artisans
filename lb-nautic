<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LB Nautic - Entretien, réparation et dépannage nautique moteurs hors-bord & in-board</title>
  <meta name="description" content="LB Nautic est spécialisée dans l'entretien, la réparation et le dépannage nautique : moteurs hors-bord & in-board, carénage, dans l'Hérault 34 et le Gard 30.">
  <meta name="theme-color" content="#071b2f">
  <style>
    :root {
      --deep: #071b2f;
      --deep-2: #0d2d43;
      --ink: #10202b;
      --muted: #66737c;
      --foam: #f7f3ea;
      --white: #ffffff;
      --mist: #edf4f2;
      --brass: #c99b5d;
      --hull: #a7653d;
      --line: rgba(16, 32, 43, .14);
      --line-light: rgba(247, 243, 234, .18);
      --shadow: 0 24px 70px rgba(7, 27, 47, .22);
      --radius: 8px;
      --max: 1180px;
      --section: clamp(68px, 9vw, 128px);
      font-family: Arial, Helvetica, sans-serif;
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      background: var(--foam);
      color: var(--ink);
    }

    body {
      margin: 0;
      font-size: 16px;
      line-height: 1.65;
      color: var(--ink);
      background: var(--foam);
    }

    body.nav-open { overflow: hidden; }

    img {
      max-width: 100%;
      display: block;
      object-fit: cover;
    }

    a { color: inherit; }

    .skip-link {
      position: absolute;
      left: 16px;
      top: 12px;
      z-index: 100;
      transform: translateY(-140%);
      background: var(--foam);
      color: var(--deep);
      padding: 10px 14px;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .skip-link:focus { transform: translateY(0); }

    .container {
      width: min(var(--max), calc(100% - 32px));
      margin: 0 auto;
    }

    .site-header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 20;
      color: var(--foam);
    }

    .nav-wrap {
      width: min(var(--max), calc(100% - 32px));
      min-height: 80px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      font-weight: 800;
    }

    .brand svg {
      width: 32px;
      height: 32px;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
      color: var(--brass);
    }

    .brand span {
      display: block;
      font-size: 20px;
      letter-spacing: .01em;
    }

    .brand small {
      display: block;
      margin-top: -4px;
      color: rgba(247, 243, 234, .68);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0;
    }

    .nav-toggle {
      width: 46px;
      height: 46px;
      border: 1px solid rgba(247, 243, 234, .34);
      border-radius: 999px;
      color: var(--foam);
      background: rgba(7, 27, 47, .22);
      display: inline-grid;
      place-items: center;
      cursor: pointer;
      backdrop-filter: blur(8px);
    }

    .nav-toggle svg,
    .icon svg,
    .mini-icon svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .nav-links {
      position: fixed;
      inset: 80px 16px auto 16px;
      display: none;
      flex-direction: column;
      gap: 4px;
      padding: 12px;
      border: 1px solid var(--line-light);
      border-radius: var(--radius);
      color: var(--foam);
      background: rgba(7, 27, 47, .96);
      box-shadow: var(--shadow);
    }

    .nav-open .nav-links { display: flex; }

    .nav-links a {
      min-height: 44px;
      display: flex;
      align-items: center;
      padding: 8px 12px;
      border-radius: var(--radius);
      text-decoration: none;
      color: rgba(247, 243, 234, .82);
      font-size: 14px;
      font-weight: 800;
    }

    .nav-links a:hover,
    .nav-links a:focus-visible {
      color: var(--brass);
      background: rgba(247, 243, 234, .06);
    }

    .header-call {
      display: none;
      min-height: 42px;
      align-items: center;
      gap: 8px;
      padding: 9px 15px;
      border: 1px solid rgba(247, 243, 234, .34);
      border-radius: 999px;
      color: var(--foam);
      text-decoration: none;
      font-size: 14px;
      font-weight: 800;
      transition: background .2s ease, color .2s ease;
    }

    .header-call:hover {
      background: var(--foam);
      color: var(--deep);
    }

    .btn {
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 22px;
      border: 1px solid transparent;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 900;
      line-height: 1.2;
      transition: transform .2s ease, background .2s ease, color .2s ease, border-color .2s ease;
    }

    .btn:hover { transform: translateY(-1px); }

    .btn-primary {
      background: var(--brass);
      color: var(--deep);
      box-shadow: 0 12px 30px rgba(201, 155, 93, .22);
    }

    .btn-primary:hover { background: var(--foam); }

    .btn-light {
      color: var(--foam);
      border-color: rgba(247, 243, 234, .44);
      background: rgba(247, 243, 234, .06);
    }

    .btn-light:hover { background: rgba(247, 243, 234, .14); }

    .btn-outline {
      color: var(--deep);
      background: transparent;
      border-color: rgba(16, 32, 43, .24);
    }

    .btn-outline:hover { border-color: var(--deep); }

    .btn:focus-visible,
    button:focus-visible,
    a:focus-visible,
    summary:focus-visible {
      outline: 3px solid rgba(201, 155, 93, .62);
      outline-offset: 4px;
    }

    .hero {
      position: relative;
      min-height: 100svh;
      display: grid;
      align-items: end;
      overflow: hidden;
      color: var(--foam);
      background: var(--deep);
      isolation: isolate;
    }

    .hero > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -3;
    }

    .hero::before,
    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -2;
    }

    .hero::before {
      background:
        linear-gradient(180deg, rgba(7, 27, 47, .72) 0%, rgba(7, 27, 47, .44) 36%, rgba(7, 27, 47, .92) 100%),
        linear-gradient(90deg, rgba(7, 27, 47, .92), rgba(7, 27, 47, .36) 62%, rgba(7, 27, 47, .62));
    }

    .hero::after {
      inset: auto 0 0 0;
      height: 28%;
      z-index: -1;
      background: linear-gradient(180deg, transparent, var(--deep));
    }

    .hero-inner {
      width: min(var(--max), calc(100% - 32px));
      margin: 0 auto;
      padding: 128px 0 40px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 18px;
      color: var(--brass);
      text-transform: uppercase;
      letter-spacing: .22em;
      font-size: 12px;
      font-weight: 900;
    }

    .eyebrow::before {
      content: "";
      width: 34px;
      height: 1px;
      background: currentColor;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1,
    h2,
    .display {
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 500;
      letter-spacing: 0;
    }

    h1 {
      max-width: 980px;
      margin-bottom: 24px;
      font-size: clamp(46px, 10vw, 118px);
      line-height: .92;
    }

    h1 em,
    h2 em {
      color: var(--brass);
      font-style: italic;
    }

    .hero-lead {
      max-width: 650px;
      margin-bottom: 30px;
      color: rgba(247, 243, 234, .82);
      font-size: clamp(18px, 2vw, 22px);
    }

    .hero-actions,
    .actions,
    .contact-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .hero-facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-top: clamp(42px, 9vw, 80px);
      padding-top: 26px;
      border-top: 1px solid rgba(247, 243, 234, .18);
    }

    .fact strong {
      display: block;
      color: var(--brass);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(30px, 5vw, 46px);
      font-weight: 500;
      line-height: 1;
    }

    .fact span {
      display: block;
      margin-top: 8px;
      color: rgba(247, 243, 234, .66);
      text-transform: uppercase;
      letter-spacing: .14em;
      font-size: 11px;
      font-weight: 900;
    }

    .service-ribbon {
      overflow: hidden;
      border-top: 1px solid rgba(247, 243, 234, .12);
      border-bottom: 1px solid rgba(247, 243, 234, .12);
      background: var(--deep);
      color: rgba(247, 243, 234, .72);
    }

    .ribbon-track {
      display: flex;
      width: max-content;
      gap: 38px;
      padding: 16px 0;
      animation: ribbon 34s linear infinite;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(24px, 4vw, 36px);
      white-space: nowrap;
    }

    .ribbon-track span {
      display: inline-flex;
      align-items: center;
      gap: 38px;
    }

    .ribbon-track span::after {
      content: "*";
      color: var(--brass);
      font-family: Arial, Helvetica, sans-serif;
    }

    @keyframes ribbon {
      from { transform: translateX(0); }
      to { transform: translateX(-33.333%); }
    }

    section {
      padding: var(--section) 0;
      scroll-margin-top: 88px;
    }

    .section-dark {
      background: var(--deep);
      color: var(--foam);
    }

    .section-light { background: var(--foam); }
    .section-white { background: var(--white); }

    .section-head {
      display: grid;
      gap: 16px;
      margin-bottom: clamp(36px, 6vw, 70px);
    }

    .section-head h2 {
      max-width: 780px;
      margin-bottom: 0;
      font-size: clamp(36px, 6vw, 70px);
      line-height: .98;
    }

    .section-head p {
      max-width: 650px;
      margin-bottom: 0;
      color: var(--muted);
      font-size: 18px;
    }

    .section-dark .section-head p,
    .section-dark .muted { color: rgba(247, 243, 234, .72); }

    .split {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(34px, 7vw, 76px);
      align-items: center;
    }

    .media-frame {
      overflow: hidden;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      background: var(--deep-2);
    }

    .media-frame img {
      width: 100%;
      height: 100%;
      aspect-ratio: 4 / 5;
    }

    .about-copy {
      max-width: 620px;
    }

    .about-copy p {
      color: var(--muted);
      font-size: 18px;
    }

    .proof-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
      margin-top: 34px;
    }

    .proof {
      padding-left: 18px;
      border-left: 2px solid var(--brass);
    }

    .proof strong {
      display: block;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 21px;
      font-weight: 500;
    }

    .proof span {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 14px;
    }

    .service-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1px;
      border: 1px solid rgba(247, 243, 234, .12);
      background: rgba(247, 243, 234, .12);
    }

    .service-card {
      min-height: 280px;
      padding: clamp(28px, 5vw, 48px);
      background: var(--deep);
      transition: background .2s ease, transform .2s ease;
    }

    .service-card:hover {
      background: var(--deep-2);
    }

    .service-top {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 38px;
      color: var(--brass);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .22em;
    }

    .service-card h3 {
      max-width: 430px;
      margin-bottom: 14px;
      color: var(--foam);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(29px, 4vw, 43px);
      font-weight: 500;
      line-height: 1.05;
    }

    .service-card p {
      max-width: 460px;
      color: rgba(247, 243, 234, .72);
      margin-bottom: 0;
    }

    .steps {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
      counter-reset: step;
    }

    .step {
      position: relative;
      padding: 28px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--white);
    }

    .step::before {
      counter-increment: step;
      content: counter(step, decimal-leading-zero);
      display: block;
      margin-bottom: 18px;
      color: var(--hull);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 34px;
      line-height: 1;
    }

    .step h3 {
      margin-bottom: 8px;
      font-size: 21px;
      line-height: 1.2;
    }

    .step p { color: var(--muted); margin-bottom: 0; }

    .zone {
      position: relative;
      overflow: hidden;
      color: var(--foam);
      isolation: isolate;
    }

    .zone img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
    }

    .zone::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(90deg, rgba(7, 27, 47, .86), rgba(7, 27, 47, .45)),
        linear-gradient(180deg, rgba(7, 27, 47, .22), rgba(7, 27, 47, .86));
    }

    .zone-content {
      max-width: 760px;
      padding: clamp(28px, 6vw, 64px) 0;
    }

    .zone-content h2 {
      margin-bottom: 20px;
      font-size: clamp(38px, 7vw, 76px);
      line-height: .98;
    }

    .zone-content p {
      max-width: 610px;
      color: rgba(247, 243, 234, .8);
      font-size: 18px;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding: 0;
      margin: 30px 0 0;
      list-style: none;
    }

    .chips li {
      padding: 9px 13px;
      border: 1px solid rgba(247, 243, 234, .32);
      border-radius: 999px;
      color: rgba(247, 243, 234, .9);
      background: rgba(247, 243, 234, .06);
      font-size: 14px;
      font-weight: 800;
    }

    .hours-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(32px, 6vw, 70px);
      align-items: start;
    }

    .hours-list {
      border-top: 1px solid var(--line);
    }

    .hours-row {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      padding: 15px 0;
      border-bottom: 1px solid var(--line);
    }

    .hours-row strong {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 20px;
      font-weight: 500;
    }

    .hours-row span { color: var(--muted); text-align: right; }

    .faq-list {
      display: grid;
      gap: 12px;
      max-width: 880px;
    }

    details {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--white);
      padding: 0 20px;
    }

    summary {
      min-height: 62px;
      display: flex;
      align-items: center;
      cursor: pointer;
      font-weight: 900;
    }

    details p {
      color: var(--muted);
      padding-bottom: 20px;
      margin-bottom: 0;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .testimonial-card {
      display: grid;
      gap: 16px;
      align-content: start;
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--white);
      box-shadow: 0 16px 40px rgba(7, 27, 47, .07);
    }

    .testimonial-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px 14px;
    }

    .testimonial-meta strong {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 22px;
      font-weight: 500;
      line-height: 1.2;
    }

    .testimonial-meta span {
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
    }

    .review-source {
      color: var(--hull);
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: 11px;
      font-weight: 900;
    }

    .testimonial-card blockquote {
      margin: 0;
      color: var(--muted);
      white-space: pre-line;
    }

    .contact {
      background: var(--deep);
      color: var(--foam);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: start;
    }

    .contact h2 {
      max-width: 560px;
      margin-bottom: 22px;
      font-size: clamp(38px, 7vw, 76px);
      line-height: .98;
    }

    .contact p {
      max-width: 540px;
      color: rgba(247, 243, 234, .74);
      font-size: 18px;
    }

    .contact-list {
      display: grid;
      gap: 18px;
      margin-top: 34px;
    }

    .contact-item {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 14px;
      align-items: center;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(247, 243, 234, .14);
    }

    .mini-icon {
      width: 48px;
      height: 48px;
      border: 1px solid rgba(247, 243, 234, .22);
      border-radius: 999px;
      display: grid;
      place-items: center;
      color: var(--brass);
    }

    .contact-label {
      display: block;
      color: rgba(247, 243, 234, .54);
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: 11px;
      font-weight: 900;
    }

    .contact-value {
      display: block;
      color: var(--foam);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 22px;
      text-decoration: none;
      line-height: 1.25;
    }

    .contact-value:hover { color: var(--brass); }

    .contact-form {
      display: grid;
      gap: 34px;
      width: 100%;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .field {
      display: grid;
      gap: 12px;
    }

    .field label {
      color: rgba(247, 243, 234, .64);
      text-transform: uppercase;
      letter-spacing: .18em;
      font-size: 12px;
      font-weight: 900;
    }

    .field input,
    .field textarea {
      width: 100%;
      min-height: 48px;
      border: 0;
      border-bottom: 1px solid rgba(247, 243, 234, .28);
      border-radius: 0;
      background: transparent;
      color: var(--foam);
      font: inherit;
      padding: 8px 0 12px;
      outline: none;
    }

    .field textarea {
      min-height: 150px;
      resize: vertical;
    }

    .field input:focus,
    .field textarea:focus {
      border-bottom-color: var(--brass);
    }

    .form-bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
    }

    .form-note {
      margin: 0;
      color: rgba(247, 243, 234, .64);
      font-size: 14px;
    }

    footer {
      border-top: 1px solid rgba(247, 243, 234, .12);
      background: var(--deep);
      color: rgba(247, 243, 234, .62);
      padding: 28px 0;
      font-size: 14px;
    }

    footer .container {
      display: grid;
      gap: 10px;
    }

    footer strong {
      color: var(--foam);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 18px;
      font-weight: 500;
    }

    @media (min-width: 720px) {
      .hero-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .hours-grid { grid-template-columns: .9fr 1.1fr; }
      .form-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .testimonials-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .testimonial-card.featured { grid-column: span 2; }
      footer .container { grid-template-columns: auto 1fr auto; align-items: center; }
    }

    @media (min-width: 900px) {
      .nav-toggle { display: none; }
      .nav-links {
        position: static;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 22px;
        padding: 0;
        border: 0;
        background: transparent;
        box-shadow: none;
      }
      .nav-links a {
        min-height: auto;
        padding: 0;
        border-radius: 0;
        background: transparent;
      }
      .header-call { display: inline-flex; }
      .split { grid-template-columns: .88fr 1.12fr; }
      .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .contact-grid { grid-template-columns: .88fr 1.12fr; }
    }

    @media (max-width: 430px) {
      .btn { width: 100%; }
      .hero-facts { grid-template-columns: 1fr; }
      h1 { font-size: 42px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
